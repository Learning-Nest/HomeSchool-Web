# Loaded by `npm run build:nonprod`. Public values only: never put secrets in this file.
# Replace the placeholder with the Terraform output `api_url` of the nonprod stack, or let the CI workflow
# inject it (a VITE_API_BASE_URL variable in the environment overrides this file).
VITE_API_BASE_URL=https://api-nonprod.homeschooling.invalid
VITE_ENV_NAME=nonprod
