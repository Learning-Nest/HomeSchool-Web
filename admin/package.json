{
  "name": "homeschooling-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content-admin console for the HomeSchooling platform (React SPA).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build:dev": "vite build --mode dev && node scripts/write-swa-config.mjs dev",
    "build:nonprod": "vite build --mode nonprod && node scripts/write-swa-config.mjs nonprod",
    "build:prod": "vite build --mode prod && node scripts/write-swa-config.mjs prod",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rolldown/binding-win32-x64-msvc": "1.2.9",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
