# Loaded by `npm run build:prod`. Public values only: never put secrets in this file.
# Replace the placeholder with the Terraform output `api_url` of the prod stack, or let the CI workflow
# inject it (a VITE_API_BASE_URL variable in the environment overrides this file).
# VITE_ENV_NAME=prod shows no environment badge in the console.
VITE_API_BASE_URL=https://api.homeschooling.invalid
VITE_ENV_NAME=prod
